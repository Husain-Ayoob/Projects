{
  "allowed_commands": [
    "smartctl",
    "memtester",
    "lshw",
    "dmesg",
    "fsck",
    "e2fsck",
    "chkrootkit",
    "iostat",
    "vmstat",
    "lsblk",
    "lspci",
    "lsusb",
    "dmidecode",
    "hdparm",
    "badblocks",
    "mount",
    "umount",
    "df",
    "du",
    "free",
    "top",
    "ps",
    "systemctl",
    "journalctl",
    "ip",
    "ifconfig",
    "ping",
    "traceroute",
    "netstat",
    "ss",
    "clamscan",
    "grep",
    "awk",
    "sed",
    "cat",
    "tail",
    "head",
    "find",
    "ls",
    "chmod",
    "chown",
    "sync",
    "tune2fs",
    "blkid",
    "parted",
    "fdisk"
  ],
  "forbidden_commands": [
    "rm -rf /",
    "rm -rf /*",
    "mkfs",
    "dd if=/dev/zero",
    "dd of=/dev/sda",
    "dd of=/dev/sdb",
    "> /dev/sda",
    "wget | sh",
    "curl | sh",
    "chmod -R 777 /",
    "chown -R"
  ],
  "forbidden_patterns": [
    "rm.*-rf.*/$",
    "dd.*of=/dev/[sh]d[a-z]$",
    "mkfs\\..*",
    "format.*",
    ":\\(\\)\\{.*:\\|:.*\\};:",
    "\\|\\s*sh",
    "\\|\\s*bash"
  ],
  "restricted_paths": [
    "/boot/efi",
    "/sys",
    "/proc"
  ],
  "allowed_file_operations": [
    "read",
    "backup",
    "fsck",
    "mount_readonly"
  ],
  "max_file_size_mb": 1000,
  "execution_limits": {
    "max_processes": 10,
    "max_cpu_percent": 80,
    "max_memory_mb": 2048,
    "timeout_seconds": 300
  }
}
